{
    "name": "Debian",
    "build": {
        "dockerfile": "./Dockerfile"
    },
    "remoteUser": "root",
    "customizations": {
        "vscode": {
            "extensions": ["ms-vscode.cpptools-themes", "eamodio.gitlens", "ms-vscode.hexeditor", "esbenp.prettier-vscode", "rangav.vscode-thunder-client", "ms-vscode.cpptools", "fabiospampinato.vscode-highlight", "13xforever.language-x86-64-assembly"]
        }
    },
    "runArgs": ["--cap-add=SYS_PTRACE", "--security-opt", "seccomp=unconfined"]
}
